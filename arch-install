#!/usr/bin/env bash
# arch-install — 个人 Arch/CachyOS 安装器主入口
# 用法见 README.md;设计与约定见 docs/plans/ 与 AGENTS.md
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/chroot.sh
source "$SCRIPT_DIR/lib/chroot.sh"
# shellcheck source=lib/disk.sh
source "$SCRIPT_DIR/lib/disk.sh"
# shellcheck source=lib/modules.sh
source "$SCRIPT_DIR/lib/modules.sh"

# ---- 默认值 ----
TARGET="" SIZE="32G" PROFILE="server" DISTRO="arch" DESKTOP="niri"
CACHYOS_KERNEL="default" CACHYOS_REPO="auto" CPUTYPE="auto" MIRRORLIST="copy"
EXTRA_MODULES="" SKIP_MODULES="" DRY_RUN=0 FORCE=0 DEVICE=""
CONFIG_FILE="$SCRIPT_DIR/config/config.sh"

usage() {
    cat <<'EOF'
用法: sudo ./arch-install [--target] <块设备|镜像路径> [选项]

必需:
  --target PATH          /dev/sdX|/dev/nvmeXn1 → 物理盘;文件路径 → raw 镜像
                         (也可直接写裸路径,不带 --target)

常用选项:
  --size SIZE            镜像大小(默认 32G;mem-zswap 默认带 4G swapfile)
  --profile NAME         server | desktop(默认 server)
  --distro NAME          arch | cachyos(默认 arch)
  --desktop NAME         niri | kde(仅 desktop,默认 niri)
  --cachyos-kernel NAME  default|bore|bmq|lts|server|hardened|rt-bore|eevdf|rc
  --cachyos-repo NAME    auto|v3|v4|znver4(默认 auto,自动检测)
  --cputype NAME         auto|amd|intel(默认 auto;异构构建时指定目标机 CPU,
                         如在 Intel 机器上给 AMD 机器装)
  --mirrorlist MODE      copy|original|reflector|config(默认 copy)
  --extra-modules a,b    额外启用模块(--modules 可查看全部模块名)
  --modules              列出全部模块名、依赖与顺序约束
  --skip-modules a,b     跳过模块(VPS: --skip-modules hardware)
  --config FILE          指定 config.sh 路径
  --device NAME          设备预设(devices/NAME.sh,gitignored;固化 CLI 默认值
                          与 MY_* 变量,CLI 显式参数优先;模板见 devices/example.sh)
  --dry-run              只打印计划不执行
  --force                跳过物理盘确认
  -h, --help
EOF
}

# prescan_args:正式解析前只提取 --device 与 --config(设备文件需在 config.sh
# 之后、parse_args 之前 source,才能既覆盖 MY_* 又充当 CLI 默认值)。
# --modules/-h 在此提前 exit:它们原本在 parse_args 里先于 load_config 退出,
# parse_args 后移后若不在此处理,无 config.sh 时 --modules 会误报缺配置(回归)
prescan_args() {
    while (($#)); do
        case $1 in
            --device) DEVICE=$2; shift 2 ;;
            --config) CONFIG_FILE=$2; shift 2 ;;
            --modules) print_modules; exit 0 ;;
            -h|--help) usage; exit 0 ;;
            --target|--size|--profile|--distro|--desktop|--cachyos-kernel|--cachyos-repo|--cputype|--mirrorlist|--extra-modules|--skip-modules) shift 2 ;;
            *) shift ;;
        esac
    done
}

parse_args() {
    while (($#)); do
        case $1 in
            --target) TARGET=$2; shift 2 ;;
            --size) SIZE=$2; shift 2 ;;
            --profile) PROFILE=$2; shift 2 ;;
            --distro) DISTRO=$2; shift 2 ;;
            --desktop) DESKTOP=$2; shift 2 ;;
            --cachyos-kernel) CACHYOS_KERNEL=$2; shift 2 ;;
            --cachyos-repo) CACHYOS_REPO=$2; shift 2 ;;
            --cputype) CPUTYPE=$2; shift 2 ;;
            --mirrorlist) MIRRORLIST=$2; shift 2 ;;
            --extra-modules) EXTRA_MODULES=$2; shift 2 ;;
            --skip-modules) SKIP_MODULES=$2; shift 2 ;;
            --config) CONFIG_FILE=$2; shift 2 ;;
            --device) DEVICE=$2; shift 2 ;;   # prescan 已取值,此处仅消费
            --modules) print_modules; exit 0 ;;
            --dry-run) DRY_RUN=1; shift ;;
            --force) FORCE=1; shift ;;
            -h|--help) usage; exit 0 ;;
            # 裸 positional 参数作为 --target 简写(只能出现一次)
            -*) die "未知参数: $1(--help 查看用法)" ;;
            *) [[ -z $TARGET ]] || die "目标只能指定一次: $1"
               TARGET=$1; shift ;;
        esac
    done
    [[ -n $TARGET ]] || { usage; die "必须指定 --target"; }
    [[ -f $SCRIPT_DIR/profiles/$PROFILE.conf ]] || die "未知 profile: $PROFILE"
    [[ $DISTRO == arch || $DISTRO == cachyos ]] || die "未知 distro: $DISTRO"
    [[ $CPUTYPE =~ ^(auto|amd|intel)$ ]] || die "未知 cputype: $CPUTYPE(auto|amd|intel)"
}

load_config() {
    if [[ ! -f $CONFIG_FILE ]]; then
        die "缺少 $CONFIG_FILE —— 请先复制模板: cp config/config.example.sh config/config.sh"
    fi
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
    : "${MY_USERNAME:?config.sh 中必须设置 MY_USERNAME}"
    if [[ -f $SCRIPT_DIR/config/hooks.sh ]]; then
        # shellcheck source=/dev/null
        source "$SCRIPT_DIR/config/hooks.sh"
    fi
}

# load_device:source devices/$DEVICE.sh,固化设备级 CLI 默认值与 MY_* 变量。
# 叠加顺序:内置默认值 → config.sh → devices/X.sh → CLI 显式参数(后者覆盖前者)
load_device() {
    [[ -z $DEVICE ]] && return 0
    # 设备名只允许小写字母/数字/连字符:防 ../ 路径穿越
    [[ $DEVICE =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "非法设备名: $DEVICE(只允许小写字母/数字/连字符)"
    local f="$SCRIPT_DIR/devices/$DEVICE.sh"
    if [[ ! -f $f ]]; then
        local avail
        avail=$(find "$SCRIPT_DIR/devices" -maxdepth 1 -name '*.sh' ! -name 'example.sh' \
            -printf '%f\n' 2>/dev/null | sed 's/\.sh$//' | sort | tr '\n' ' ')
        die "缺少 $f —— 可用设备: ${avail:-无}(模板见 devices/example.sh)"
    fi
    # shellcheck source=/dev/null
    source "$f"
}

print_plan() {
    cat <<EOF
== 安装计划 ==
$([[ -n $DEVICE ]] && echo "设备:      $DEVICE")
目标:      $TARGET($TARGET_TYPE)
$([[ $TARGET_TYPE == image ]] && echo "镜像大小:  $SIZE")
发行版:    $DISTRO$([[ $DISTRO == cachyos ]] && echo "(kernel=$CACHYOS_KERNEL repo=$CACHYOS_REPO)")
Profile:   $PROFILE$([[ $PROFILE == desktop ]] && echo "(desktop=$DESKTOP)")
Mirrorlist: $MIRRORLIST
微码:      $CPUTYPE
模块顺序:  ${RESOLVED_MODULES[*]}
EOF
}

main() {
    # prescan 先提取 --device/--config:设备文件要在 config.sh 之后、
    # parse_args 之前 source,才能既覆盖 MY_* 又充当 CLI 默认值
    prescan_args "$@"
    check_deps pacstrap arch-chroot sfdisk mkfs.vfat mkfs.ext4 mkfs.btrfs \
        losetup bootctl genfstab curl rsync
    load_config
    load_device         # 叠加顺序:内置默认 → config.sh → devices/X.sh → CLI
    parse_args "$@"
    # shellcheck source=/dev/null
    source "$SCRIPT_DIR/distro/$DISTRO.sh"

    # --cputype 覆盖宿主机检测(在 Intel 机器上给 AMD 机器装时必传);
    # 影响微码包、cachyos znver4 检测与引导项 initrd 行
    [[ $CPUTYPE == auto ]] && CPUTYPE=$(detect_cputype)

    detect_target_type            # → TARGET_TYPE=disk|image
    resolve_modules "$PROFILE"    # → RESOLVED_MODULES(含 requires 闭包与拓扑序)
    print_plan
    ((DRY_RUN == 0)) || { info "dry-run,不执行"; exit 0; }
    ((EUID == 0)) || die "请用 root 运行: sudo ./arch-install ...(dry-run 不需要 root)"

    # 跨等级构建预检(仅 cachyos 有定义):目标等级高于宿主 CPU 时启用
    # qemu-user 模拟;缺依赖在此失败,不留下半成品镜像
    declare -F _cachyos_preflight_emulation &>/dev/null && _cachyos_preflight_emulation

    prepare_target                # 镜像:qemu-img+losetup;物理盘:占用检查+确认
    trap cleanup_target EXIT      # 失败/完成都 umount + losetup -d
    partition_and_mount           # → MNT_DIR

    mod_exec base                 # pacstrap + fstab + locale/时区/hostname
    distro_setup_repos            # cachyos:keyring + 仓库段;arch:no-op
    # 内核与微码需在 bootctl 前装好(initrd/initramfs 依赖)
    # 必须在当前 shell 调用:它设置 KERNEL_PKG/KERNEL_PKGS 全局供
    # install_bootloader 用,放 $() 子 shell 会丢(实测报 unbound variable)
    distro_kernel_packages
    # shellcheck disable=SC2086
    pacman_install $KERNEL_PKGS "$CPUTYPE-ucode"
    chroot_run mkinitcpio -P
    install_bootloader            # bootctl + entries(lib/disk.sh)

    local m
    for m in "${RESOLVED_MODULES[@]}"; do
        [[ $m == base ]] && continue   # 已执行
        mod_exec "$m"
    done

    distro_post_install
    if declare -F hook_post_install &>/dev/null; then
        log "执行 config/hooks.sh hook_post_install"
        hook_post_install
    fi

    # 清空 machine-id:dd/克隆到多台机器会撞 ID(官方安装器同款处理,
    # arch/cachyos 通用);空文件被 systemd 视为未初始化,首启自动生成
    : >"$MNT_DIR/etc/machine-id"
    # dbus 的 machine-id(可能是 /etc/machine-id 的 symlink 或独立副本,
    # 不一定存在)一并删掉,首启由 dbus 从 /etc/machine-id 重建
    rm -f "$MNT_DIR/var/lib/dbus/machine-id"
    # random-seed 同理:克隆会导致多台机器共用同一随机种子(原脚本同款清理)
    rm -f "$MNT_DIR/var/lib/systemd/random-seed" "$MNT_DIR/efi/loader/random-seed"

    # btrfs 根时给 /var/log/journal 设 NOCOW(非 btrfs 自动跳过;lib/disk.sh)
    setup_journal_nocow

    cleanup_target
    trap - EXIT
    info "完成!目标: $TARGET"
    if [[ $TARGET_TYPE == image ]]; then
        info "qemu 验证: qemu-system-x86_64 -m 4G -bios /usr/share/ovmf/x64/OVMF.4m.fd -drive file=$TARGET,format=raw"
    fi
}

main "$@"
